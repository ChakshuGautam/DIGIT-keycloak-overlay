{
  "name": "digit-keycloak-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:newman": "newman run tests/postman/kc-e2e.postman_collection.json --env-var keycloakUrl=$LIVE_KC_URL --env-var adminUsername=admin --env-var adminPassword=admin --env-var testRealm=pg --env-var testCity=pg.citya --folder '1. KC Admin & Realm Setup' --folder '2. User Provisioning in KC' --folder '3. OIDC Token Acquisition' --folder '5. Cross-Realm Validation' --folder '6. Cleanup' --reporters cli,junit --reporter-junit-export newman-results.xml"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-fastify": "^11.1.18",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.213.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "express": "^4.21.0",
    "fastify": "^5.8.4",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "lru-cache": "^11.2.7",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.18",
    "@swc/core": "^1.15.21",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.11",
    "newman": "^6.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^2.1.0"
  }
}
